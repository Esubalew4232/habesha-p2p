rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users profile collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'esubalewtezera4@gmail.com');
    }

    // Wallets collection
    match /wallets/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'esubalewtezera4@gmail.com');
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'esubalewtezera4@gmail.com');
    }

    // Advertisements collection
    match /advertisements/{adId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.email == 'esubalewtezera4@gmail.com');
    }

    // Trades collection
    match /trades/{tradeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Default match for other collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
